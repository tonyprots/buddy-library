{
  "name": "@tony-prots/buddy",
  "version": "0.10.0",
  "description": "Animated 3D companion for HTML presentations. Climbs slide content, performs tricks and grows bolder toward the finale. One local script.",
  "keywords": [
    "presentation",
    "slides",
    "deck",
    "character",
    "mascot",
    "animation",
    "html-presentation",
    "vanilla-javascript",
    "offline",
    "three.js",
    "webgl"
  ],
  "license": "MIT",
  "author": "Anton Protsenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyprots/buddy-library.git"
  },
  "homepage": "https://github.com/tonyprots/buddy-library#readme",
  "bugs": {
    "url": "https://github.com/tonyprots/buddy-library/issues"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./effects": {
      "types": "./src/effects.d.ts",
      "import": "./src/effects.js",
      "default": "./src/effects.js"
    },
    "./intelligence": {
      "types": "./src/slide-intelligence.d.ts",
      "import": "./src/slide-intelligence.js",
      "default": "./src/slide-intelligence.js"
    },
    "./presets/y360": {
      "types": "./src/presets/y360.d.ts",
      "import": "./src/presets/y360.js",
      "default": "./src/presets/y360.js"
    },
    "./context": {
      "types": "./src/slide-context.d.ts",
      "import": "./src/slide-context.js",
      "default": "./src/slide-context.js"
    }
  },
  "files": [
    "src",
    "dist",
    "index.html",
    "docs/slide-context.md",
    "docs/api.md",
    "docs/agent-integration.md",
    "docs/publishing.md",
    "llms.txt",
    "examples",
    "CONTRIBUTING.md",
    "docs/slide-reactions.md",
    "docs/slide-intelligence.md",
    "docs/buddy-preview.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/media"
  ],
  "sideEffects": [
    "./src/vendor.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:slow": "node --test tests/slow/*.test.mjs",
    "test:all": "node --test tests/*.test.mjs tests/slow/*.test.mjs",
    "test:browser": "node tests/browser/browser-check.mjs",
    "check": "node --check src/index.js && node --check src/runtime.js && node --check src/effects.js && node --check src/new-abilities.js && node --check src/ability-props.js && node --check src/slide-intelligence.js && node --check src/camera.js && node --check src/slide-context.js && node --check src/context-abilities.js && node --check src/context-source.js && node --check src/context-props.js && node --check src/context-stories.js && node --check src/context-story-props.js && node --check src/outfit.js && node --check src/behavior.js && node --check src/playback.js && node --check src/brand.js",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "export": "python3 scripts/export-public.py"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "engines": {
    "node": ">=18"
  }
}
